{
  "name": "flygate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:bundle": "next build && tsx scripts/check-bundle.ts",
    "bootstrap": "tsx scripts/bootstrap/index.ts",
    "evm:check": "tsx scripts/evm/check.ts",
    "live:probe": "forge build && tsx scripts/live/probe.ts",
    "test:scripts": "tsx --test 'scripts/**/*.test.ts'",
    "test:live": "tsx --conditions=react-server --test 'src/server/**/*.test.ts'",
    "test:contracts": "forge test",
    "test:contracts:ffi": "FOUNDRY_PROFILE=ffi forge test"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.1",
    "@qorechain/sdk": "^0.14.0",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.58.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.20.0"
}
