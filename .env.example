# Copy to .env.local, or just run `pnpm bootstrap`: it creates .env.local and fills in
# any missing mnemonic. Existing values are never overwritten. Never commit .env.local.

# One BIP-39 mnemonic per role. It is the only key source for that account:
# the qor1... address (secp256k1) and the ML-DSA-87 key are both derived from it.
# The server reads only AGENT_ and MERCHANT_: FlyGate's agent (books, pays every fee; keep its
# EVM signer topped up) and the demo merchant. Owners sign with their own QoreX wallet
# (ADR-0003). OWNER_MNEMONIC is a dev-only test owner for the scripts (deploy, probes,
# pnpm live:e2e-wallet); the app never reads it.
OWNER_MNEMONIC=
AGENT_MNEMONIC=
MERCHANT_MNEMONIC=

# QoreChain diana testnet
QORE_CHAIN_ID=qorechain-diana
QORE_RPC_URL=https://rpc-testnet.qore.host
QORE_REST_URL=https://api-testnet.qore.host
QORE_EVM_RPC_URL=https://evm-testnet.qore.host
QORE_EXPLORER_URL=https://explore.qore.network

# Live mode (server only; never prefix these with NEXT_PUBLIC_). Live stays disabled until all are
# set and /api/live/status passes. There is no default escrow address.
# LIVE_MODE=on enables the /api/live/* routes; anything else makes them answer 404.
LIVE_MODE=
# FlightEscrow on diana and the block it was deployed in (deployments/diana.json):
# 0xb66F174834A082cee16e7BaCC17Cb1305361C186, block 10903033.
FLIGHT_ESCROW_ADDRESS=
FLIGHT_ESCROW_DEPLOY_BLOCK=
# QOR per US$ for Live amounts (default 0.01: US$389 = 3.89 QOR).
LIVE_QOR_PER_USD=
